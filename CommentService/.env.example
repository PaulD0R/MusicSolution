POSTGRES_HOST=comment-postgres
POSTGRES_PORT=5432
POSTGRES_DB=music_comment
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=your_secure_password_here

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_INSTANCE_NAME=CommentService

YARP_HOST=yarp-music
YARP_PORT=8080

COMMENT_VIDEO_START_PATH=/app/Videos
COMMENT_PICTURE_START_PATH=/app/Pictures
LOGS_PATH=/app/Logs/log-.txt

KAFKA_BOOTSTRAP_SERVERS=kafka-server:9092

KAFKA_TOPIC_PERSON_CREATED=person-created
KAFKA_GROUP_PERSON_CREATED=comment-service-create-person

KAFKA_TOPIC_PERSON_DELETED=person-deleted
KAFKA_GROUP_PERSON_DELETED=comment-service-delete-person

KAFKA_TOPIC_MUSIC_DELETED=music-deleted
KAFKA_GROUP_MUSIC_DELETED=comment-service-delete-music

FFMPEG_PATH=/usr/bin

JWT_ISSUER=Issuer
JWT_AUDIENCE=Audience
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY----------END PUBLIC KEY-----