POSTGRES_HOST=music-postgres
POSTGRES_PORT=5432
POSTGRES_DB=music_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=your_secure_password_here

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_INSTANCE_NAME="MusicService"

YARP_HOST=yarp-music
YARP_PORT=8080

MUSIC_START_PATH=/app/Musics
LOGS_PATH=/app/Logs/log-.txt
SOCKET_PORT=8080

KAFKA_BOOTSTRAP_SERVERS=kafka-server:9092
KAFKA_TOPIC_CREATED=music-created
KAFKA_TOPIC_DELETED=music-deleted

JWT_ISSUER=YourAppIssuer
JWT_AUDIENCE=YourAppAudience
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY----------END PUBLIC KEY-----